{
  "name": "i18n",
  "version": "1.0.0",
  "description": "Your Figma Plugin",
  "license": "",
  "author": "",
  "main": "code.js",
  "scripts": {
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "watch": "node esbuild.bundle.mts --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.ui.json --noEmit && tsc --project tsconfig.node.json",
    "typecheck--watch": "npm run typecheck -- --watch",
    "build": "node esbuild.bundle.mts --build",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.142.0",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.0",
    "os-browserify": "0.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "path-browserify": "1.0.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
